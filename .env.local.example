# ─── Shopify Storefront API ───────────────────────────────────────────────────
# Your store's .myshopify.com domain (no https://)
# e.g. venom-wear.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Public Storefront API access token
# Shopify Admin → Settings → Apps → Develop apps → Create an app
# → Configure Storefront API → generate token
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token_here

# ─── Site URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: comma-separated Shopify product handles to force featured items
# If omitted, homepage uses newest products automatically.
# Example: FEATURED_PRODUCT_HANDLES=genesis,jasmyn-2-0,heaven
FEATURED_PRODUCT_HANDLES=

# ─── Custom Order Email (Resend) ──────────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Where custom order form submissions should be delivered
CUSTOM_ORDER_TO_EMAIL=you@shopvenomwear.com

# Verified sender in Resend (must be from your verified domain)
CUSTOM_ORDER_FROM_EMAIL=VenomWear <orders@shopvenomwear.com>
