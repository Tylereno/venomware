# ─── Shopify Storefront API ───────────────────────────────────────────────────
# Your store's .myshopify.com domain (no https://)
# e.g. venom-wear.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Public Storefront API access token
# Shopify Admin → Settings → Apps → Develop apps → Create an app
# → Configure Storefront API → generate token
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token_here

# ─── Site URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── NextAuth (Google + Facebook Login) ──────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_string

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
